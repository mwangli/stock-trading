# CI/CD 会把后端镜像更新为提交 SHA；本地构建可继续使用默认值。
STOCK_BACKEND_IMAGE=stock-trading-backend:local

# 数据库连接与密码。复制为 .env 后替换，禁止提交真实值。
DATABASE_HOST=127.0.0.1
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT

# 数据库持久化位置和初始化约束与现有数据绑定，迁移前不要随意修改。
MYSQL_DATA_DIR=./data/mysql
MONGO_DATA_DIR=./data/mongo
MYSQL_LOWER_CASE_TABLE_NAMES=1

# 高风险能力门禁。默认关闭，完成账户、风控和 OCR 验收后再按需开启。
TRADING_REAL_WRITE_ENABLED=false
ZXBROKER_ENABLED=false
ZXBROKER_CAPTCHA_AUTO_SUBMIT_ENABLED=false

# 系统运行控制默认值。数据库首次初始化后由“系统配置”页面中的值优先生效。
# 留空时本机使用主机名，Docker Compose 使用 stock-backend；多实例部署必须显式配置唯一值。
APP_NODE_ID=
SPRING_QUARTZ_AUTO_STARTUP=true
DATA_COLLECTION_ENABLED=true
NEWS_COLLECTION_ENABLED=true
APP_STARTUP_LISTENER_ENABLED=true
APP_STARTUP_HISTORY_SYNC_ENABLED=false
APP_STARTUP_NEWS_SYNC_ENABLED=false
LSTM_TRAINING_ENABLED=false

# Agent 密钥仅注入后端容器，不要写入前端环境或提交真实值；其他 Agent 参数统一维护在 application.yml。
DEEPSEEK_API_ENABLE=true
DEEPSEEK_API_KEY=
AGENT_ENABLED=true
AGENT_PROVIDER=ollama
AGENT_TIMEOUT_MS=120000
AGENT_EMBEDDING_ENABLED=false
AGENT_EMBEDDING_PROVIDER=djl
EMBEDDING_MODEL_PATH=./stock-backend/data/models/embedding/bge-base-zh-v1.5
AGENT_CIRCUIT_BREAKER_ENABLED=true
AGENT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_BREAKER_OPEN_DURATION_MS=60000
OLLAMA_API_KEY=ollama
OLLAMA_THINK=false
OLLAMA_MAX_TOKENS=256
OLLAMA_ENABLED=true
AGENT_EMBEDDING_API_KEY=ollama

# 情感模型宿主机只读制品目录，默认与 stock-backend/data/models/sentiment 保持一致。
SENTIMENT_ARTIFACT_HOST_DIR=./stock-backend/data/models/sentiment
SENTIMENT_MODEL_VERSION=finbert-tone-chinese-e91b1a3a

# 券商账户与协议凭据。
ZXBROKER_MOBILE_CODE=
ZXBROKER_ACCOUNT=
ZXBROKER_ENCODED_PASSWORD=
ZXBROKER_SIGN_KEY=
ZXBROKER_INTACT_TO_SERVER=

# 百度云 OCR 凭据。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
