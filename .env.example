# CI/CD 会把三个模块镜像更新为提交 SHA；本地构建可继续使用默认值。
STOCK_BACKEND_IMAGE=stock-trading-backend:local
STOCK_AGENT_IMAGE=stock-trading-agent:local
STOCK_FRONTEND_IMAGE=stock-trading-frontend:local

# Backend 与 Agent 的内部接口共享令牌，必须使用高强度随机值。
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_API_TOKEN

# MySQL 权威业务库。复制为 .env 后替换，禁止提交真实值。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=stock_trading
MYSQL_USER=stock
MYSQL_PASSWORD=CHANGE_ME_MYSQL_USER
MYSQL_DATA_DIR=./data/mysql
MYSQL_MAX_POOL_SIZE=10
MYSQL_MIN_IDLE=2

# MongoDB 增量、时序、大文档和 GridFS 存储。
DATABASE_HOST=127.0.0.1
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT
MONGO_DATA_DIR=./data/mongo

# Redis 仅用于缓存和共享 Session，不保存权威业务状态。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_DATA_DIR=./data/redis

# 高风险能力门禁。默认关闭，完成账户、风控和 OCR 验收后再按需开启。
TRADING_REAL_WRITE_ENABLED=false
ZXBROKER_ENABLED=false
ZXBROKER_CAPTCHA_AUTO_SUBMIT_ENABLED=false

# 系统运行控制默认值。数据库首次初始化后由“系统配置”页面中的值优先生效。
# 留空时本机使用主机名，Docker Compose 使用 stock-backend；多实例部署必须显式配置唯一值。
APP_NODE_ID=
SPRING_QUARTZ_AUTO_STARTUP=true
APP_STARTUP_DATA_SYNC_ENABLED=true

# Agent 仅保留必须由运行环境注入的密钥；普通运行参数统一维护在 application.yml。
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=

SENTIMENT_MODEL_VERSION=finbert-tone-chinese-e91b1a3a

# 券商账户与协议凭据。
ZXBROKER_MOBILE_CODE=
ZXBROKER_ACCOUNT=
ZXBROKER_ENCODED_PASSWORD=
ZXBROKER_SIGN_KEY=
ZXBROKER_INTACT_TO_SERVER=

# 百度云 OCR 凭据。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
