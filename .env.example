# CI/CD 会把后端镜像更新为提交 SHA；本地构建可继续使用默认值。
STOCK_BACKEND_IMAGE=stock-trading-backend:local

# 数据库连接与密码。复制为 .env 后替换，禁止提交真实值。
DATABASE_HOST=127.0.0.1
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT

# 数据库持久化位置和初始化约束与现有数据绑定，迁移前不要随意修改。
MYSQL_DATA_DIR=./data/mysql
MONGO_DATA_DIR=./data/mongo
MYSQL_LOWER_CASE_TABLE_NAMES=1

# 高风险能力门禁。默认关闭，完成账户、风控和 OCR 验收后再按需开启。
TRADING_REAL_WRITE_ENABLED=false
ZXBROKER_ENABLED=false
ZXBROKER_CAPTCHA_AUTO_SUBMIT_ENABLED=false

# 券商账户与协议凭据。
ZXBROKER_MOBILE_CODE=
ZXBROKER_ACCOUNT=
ZXBROKER_ENCODED_PASSWORD=
ZXBROKER_SIGN_KEY=
ZXBROKER_INTACT_TO_SERVER=

# 百度云 OCR 凭据。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
