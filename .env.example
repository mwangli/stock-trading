# 镜像版本。首次部署前应在可访问镜像仓库的环境中确认标签并锁定镜像摘要。
STOCK_WEB_IMAGE=stock-trading-web:local
STOCK_BACKEND_IMAGE=stock-trading-backend:local
MYSQL_IMAGE=mysql:8.0.43
MONGO_IMAGE=mongo:6.0.26
CHROME_IMAGE=selenium/standalone-chrome:4.35.0-20250828

# 数据库凭据。复制为 .env 后替换，禁止提交真实值。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=stock_trading
MYSQL_APP_USER=stock
MYSQL_APP_PASSWORD=CHANGE_ME_MYSQL_APP
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT
MONGO_DATABASE=stock_trading
MONGO_APP_USER=stock
MONGO_APP_PASSWORD=CHANGE_ME_MONGO_APP

# 仅保留真实交易：LIVE_MANUAL 每笔人工确认，LIVE_AUTO 为无人值守。
TRADING_MODE=LIVE_MANUAL
# 真实委托总门禁默认关闭，完成账户核验和人工确认后才能开启。
TRADING_REAL_WRITE_ENABLED=false
TRADING_HISTORY_MONTH_INTERVAL_MS=500
TRADING_AUTO_BUY_AMOUNT=1000
TRADING_AUTO_CANDIDATE_LIMIT=1
TRADING_TAKE_PROFIT_PERCENT=3
TRADING_FORCE_EXIT_TIME=14:50
BACKTEST_UNIVERSE_LIMIT=500
BACKTEST_LOOKBACK_DAYS=5
BACKTEST_RANDOM_SEED=20260925
BACKTEST_COMMISSION_RATE=0.0005
BACKTEST_MINIMUM_COMMISSION=5
BACKTEST_STAMP_DUTY_RATE=0.0005
BACKTEST_TRANSFER_FEE_RATE=0
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_FALLBACK_PRICE_LIMIT_RATE=0.10
BACKTEST_FEE_VERSION=CN_A_SHARE_ASSUMPTION_2026-09-25
APP_CODE_VERSION=WORKTREE_UNCOMMITTED
ZXBROKER_ENABLED=false
ZXBROKER_MOBILE_CODE=
ZXBROKER_ACCOUNT=
ZXBROKER_SIGN_KEY=
ZXBROKER_INTACT_TO_SERVER=
ZXBROKER_HISTORY_PAGE_SIZE=500
ZXBROKER_HISTORY_MAX_RECORDS_PER_WINDOW=5000
ZXBROKER_HISTORY_REQUEST_INTERVAL_MS=200
STOCK_AUTO_LOGIN_ACCOUNT=
STOCK_AUTO_LOGIN_PASSWORD=

# 可选微信小程序订阅消息通道。模板字段名需与申请的模板一致。
WECHAT_NOTIFICATION_ENABLED=false
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_OPEN_ID=
WECHAT_MINIPROGRAM_TEMPLATE_ID=
WECHAT_MINIPROGRAM_PAGE=pages/index/index
WECHAT_MINIPROGRAM_TITLE_FIELD=thing1
WECHAT_MINIPROGRAM_CONTENT_FIELD=thing2

# 可选邮件验证码通道。
AUTO_LOGIN_SMS_MAIL_ENABLED=false
AUTO_LOGIN_SMS_MAIL_HOST=
AUTO_LOGIN_SMS_MAIL_PORT=993
AUTO_LOGIN_SMS_MAIL_USERNAME=
AUTO_LOGIN_SMS_MAIL_PASSWORD=

# 默认关闭启动时重任务，由统一调度中心按需执行。
APP_STARTUP_HISTORY_SYNC_ENABLED=false
APP_STARTUP_NEWS_SYNC_ENABLED=false
APP_STARTUP_MODEL_TRAINING_ENABLED=false

# 分环境入口端口。
DEV_WEB_HTTP_PORT=3000
DEV_BACKEND_HTTP_PORT=8080
PROD_WEB_HTTP_PORT=80
CHROME_GRID_PORT=4444
CHROME_VNC_PORT=7900
MYSQL_HOST_PORT=6033
MONGO_HOST_PORT=27017

# 生产资源默认值，可按服务器规格覆盖。
BACKEND_MEMORY_LIMIT=4g
BACKEND_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.50
CHROME_MEMORY_LIMIT=2g
CHROME_CPU_LIMIT=1.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_CPU_LIMIT=1.0
MONGO_MEMORY_LIMIT=2g
MONGO_CPU_LIMIT=1.0
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai
