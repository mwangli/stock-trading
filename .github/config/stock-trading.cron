# AI_GENERATE_START --------------
# STOCK_TRADING_CRON_BEGIN
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=Asia/Shanghai
MAILTO=""

STOCK_ENV=/etc/stock-trading/env
LOG=/var/log/stock-trading/run.log
LOCK=/data/stock-trading/state/scheduler.lock
LOGROTATE=__DEPLOY_DIR__/cron/stock-trading.logrotate
LOGROTATE_STATE=/data/stock-trading/state/logrotate.status

# Log rotation
30 2 * * * /usr/sbin/logrotate -s "$LOGROTATE_STATE" "$LOGROTATE"

# Morning sell
35 9 * * 1-5 /usr/bin/flock -n "$LOCK" /bin/bash -lc 'set -a; source "$STOCK_ENV"; set +a; exec stock-trading trading --sell' >> "$LOG" 2>&1

# Afternoon buy
5 13 * * 1-5 /usr/bin/flock -n "$LOCK" /bin/bash -lc 'set -a; source "$STOCK_ENV"; set +a; exec stock-trading trading --buy' >> "$LOG" 2>&1

# Daily stock data collection
30 15 * * 1-5 /usr/bin/flock -n "$LOCK" /bin/bash -lc 'set -a; source "$STOCK_ENV"; set +a; exec stock-trading collect' >> "$LOG" 2>&1

# Daily close
30 16 * * 1-5 /usr/bin/flock -n "$LOCK" /bin/bash -lc 'set -a; source "$STOCK_ENV"; set +a; exec stock-trading close' >> "$LOG" 2>&1
# STOCK_TRADING_CRON_END
# AI_GENERATE_END --------------
