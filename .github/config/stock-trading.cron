# STOCK_TRADING_CRON_BEGIN
PATH=__PROJECT_DIR__/venv/bin:__SYSTEM_PATH__
CRON_TZ=Asia/Shanghai
MAILTO=""

PROJECT_DIR=__PROJECT_DIR__
LOG=__PROJECT_DIR__/logs/run.log
STOCK_TRADING_FILE_LOG=1
STOCK_TRADING_CONSOLE_LOG=0
LOCK=__PROJECT_DIR__/data/state/scheduler.lock
SCHEDULER=__PROJECT_DIR__/config/scheduler.sh
LOGROTATE=__PROJECT_DIR__/config/stock-trading.logrotate
LOGROTATE_STATE=__PROJECT_DIR__/data/state/logrotate.status

# Sell during 09:30-11:30 continuous trading, then buy during 14:00-15:00
30 9 * * 1-5 "$SCHEDULER" run "stock-settle --sell"
0 14 * * 1-5 "$SCHEDULER" run "stock-settle --buy"

# After-close data readiness checks precede next-trading-day ranking.
# If a provider is late, report failure; never reuse a stale execution-date signal.
10 16 * * 1-5 "$SCHEDULER" run "stock-collect" "stock-prepare" "stock-rank"

# Historical orders and model review
20 20 * * 1-5 "$SCHEDULER" run "stock-order" "stock-review"

# Weekly cleanup and daily log rotation
0 3 * * 0 "$SCHEDULER" run "stock-clean"
30 3 * * * logrotate -s "$LOGROTATE_STATE" "$LOGROTATE"
# STOCK_TRADING_CRON_END
