# STOCK_TRADING_CRON_BEGIN
PATH=__PROJECT_DIR__/venv/bin:__SYSTEM_PATH__
CRON_TZ=Asia/Shanghai
MAILTO=""

PROJECT_DIR=__PROJECT_DIR__
LOG=__PROJECT_DIR__/logs/run.log
STOCK_TRADING_FILE_LOG=1
STOCK_TRADING_CONSOLE_LOG=0
LOCK=__PROJECT_DIR__/data/state/scheduler.lock
LOGROTATE=__PROJECT_DIR__/cron/stock-trading.logrotate
LOGROTATE_STATE=__PROJECT_DIR__/data/state/logrotate.status

# Morning sell
35 9 * * 1-5 flock -n "$LOCK" bash -c 'set -e; cd "$PROJECT_DIR"; exec "$PROJECT_DIR/venv/bin/stock-sell"' > /dev/null 2>> "$LOG"

# Afternoon buy
5 13 * * 1-5 flock -n "$LOCK" bash -c 'set -e; cd "$PROJECT_DIR"; exec "$PROJECT_DIR/venv/bin/stock-buy"' > /dev/null 2>> "$LOG"

# Market data, Qlib and ranking
30 16 * * 1-5 flock -n "$LOCK" bash -c 'set -e; cd "$PROJECT_DIR"; "$PROJECT_DIR/venv/bin/stock-collect"; "$PROJECT_DIR/venv/bin/stock-prepare"; exec "$PROJECT_DIR/venv/bin/stock-rank"' > /dev/null 2>> "$LOG"

# Broker facts, performance and evaluation
20 20 * * 1-5 flock -n "$LOCK" bash -c 'set -e; cd "$PROJECT_DIR"; "$PROJECT_DIR/venv/bin/stock-broker"; "$PROJECT_DIR/venv/bin/stock-perform"; exec "$PROJECT_DIR/venv/bin/stock-evaluate"' > /dev/null 2>> "$LOG"

# Weekly cleanup and daily log rotation
0 3 * * 0 flock -n "$LOCK" bash -c 'set -e; cd "$PROJECT_DIR"; exec "$PROJECT_DIR/venv/bin/stock-clean"' > /dev/null 2>> "$LOG"
30 3 * * * logrotate -s "$LOGROTATE_STATE" "$LOGROTATE"
# STOCK_TRADING_CRON_END
