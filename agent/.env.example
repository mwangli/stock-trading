DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
STOCK_AGENT_GITHUB_TOKEN=
STOCK_AGENT_GITHUB_REPOSITORY=mwangli/stock-trading
STOCK_AGENT_GITHUB_TARGET_BRANCH=stock-agent
STOCK_AGENT_GITHUB_WORKFLOW=agent-ci.yml
STOCK_AGENT_HOME=/home/root/stock-agent
STOCK_TRADING_HOME=/home/root/stock-trading
STOCK_TRADING_DATA_DIR=/home/root/stock-trading/data
STOCK_AGENT_MAX_TOOL_ROUNDS=6
STOCK_AGENT_MAX_QUERY_ROWS=200
STOCK_AGENT_TIMEOUT_SECONDS=120
STOCK_AGENT_MAX_REPAIR_ROUNDS=2
STOCK_AGENT_REPAIR_POLL_SECONDS=10
STOCK_AGENT_REPAIR_TIMEOUT_SECONDS=1800
STOCK_AGENT_MAX_REPAIR_FILES=20
STOCK_AGENT_MAX_REPAIR_FILE_BYTES=163840