<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.stock</groupId>
        <artifactId>stock-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>stock-application</artifactId>
    <name>stock-application</name>
    <dependencies>
        <dependency><groupId>com.stock</groupId><artifactId>stock-base</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-data</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-model</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-strategy</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-trading</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-platform</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.stock</groupId><artifactId>stock-agent</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-cache</artifactId></dependency>
        <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-devtools</artifactId><scope>runtime</scope><optional>true</optional></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.stock.StockBackendApplication</mainClass>
                    <addResources>true</addResources>
                    <excludes>
                        <exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude>
                    </excludes>
                </configuration>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>pytorch-linux-x86_64</id>
            <activation><os><family>unix</family><arch>amd64</arch></os></activation>
            <dependencies>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId><artifactId>pytorch-native-cpu</artifactId>
                    <version>${pytorch.version}</version><classifier>linux-x86_64</classifier><scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>ai.djl.pytorch</groupId><artifactId>pytorch-jni</artifactId>
                    <version>${pytorch.version}-${djl.version}</version><scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
